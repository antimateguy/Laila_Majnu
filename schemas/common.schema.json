{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laila-majnu.invalid/schemas/common.schema.json",
  "title": "Common",
  "description": "Shared enums and bounded primitives referenced by the DTO schemas (ADR-0007). Defines no document of its own.",
  "$defs": {
    "schema_version": {
      "description": "Major must be 1; the server accepts the current and previous minor.",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "policy_version": {
      "description": "Date-stamped version of a policy or content file.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "request_id": {
      "description": "Client-generated lowercase UUID; the server is idempotent on it for 24 h.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "persona": {
      "title": "Persona",
      "description": "The user's persona. Presentation only: never changes parsing, metrics, scores or tier.",
      "enum": [
        "MAJNU",
        "LAILA"
      ]
    },
    "platform": {
      "title": "Platform",
      "enum": [
        "whatsapp",
        "instagram"
      ]
    },
    "side": {
      "title": "Side",
      "enum": [
        "SELF",
        "OTHER"
      ]
    },
    "momentum": {
      "title": "Momentum",
      "enum": [
        "RISING",
        "STEADY",
        "FADING"
      ]
    },
    "tier_id": {
      "title": "TierId",
      "description": "Tier_00 is trailer mode; Tier_01..Tier_09 are the 3x3 grid in row-major order.",
      "enum": [
        "Tier_00",
        "Tier_01",
        "Tier_02",
        "Tier_03",
        "Tier_04",
        "Tier_05",
        "Tier_06",
        "Tier_07",
        "Tier_08",
        "Tier_09"
      ]
    },
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "capabilities": {
      "title": "Capabilities",
      "description": "What the source format can measure (ParserCapabilities).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reactions",
        "seconds_precision",
        "edit_markers",
        "explicit_timezone"
      ],
      "properties": {
        "reactions": {
          "type": "boolean"
        },
        "seconds_precision": {
          "type": "boolean"
        },
        "edit_markers": {
          "type": "boolean"
        },
        "explicit_timezone": {
          "type": "boolean"
        }
      }
    }
  }
}
